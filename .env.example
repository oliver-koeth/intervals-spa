# intervals-spa environment configuration
# Used only by the standalone scripts in tools/ (the deployed webapp has no backend and
# reads credentials from the browser Settings screen / localStorage instead).
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# ── intervals.icu ─────────────────────────────────────────────────────────────
# Your intervals.icu athlete ID (found at the bottom of /settings)
INTERVALS_ATHLETE_ID=i00000

# Your intervals.icu API key (generated in /settings → Developer Settings)
INTERVALS_API_KEY=your-api-key-here
